# === เข้าสู่ระบบด้วย LINE ===
# 1) เข้า developers.line.biz → สร้าง Provider → สร้างช่องแบบ "LINE Login"
# 2) แท็บ Basic settings → คัดลอก Channel ID กับ Channel secret มาใส่ 2 บรรทัดล่าง
# 3) แท็บ LINE Login → Callback URL ใส่ให้ตรงกับโดเมนที่ใช้จริง:
#       https://new78.com/api/oauth/line/callback
#    (ย้ายไป gucut.com เมื่อไหร่ ต้องมาเพิ่ม callback ของโดเมนใหม่ด้วย ใส่ได้หลายอันพร้อมกัน)
# 4) ตั้ง NEXT_PUBLIC_LINE_LOGIN=1 เพื่อให้ปุ่ม LINE บนหน้าเว็บทำงาน
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_LOGIN=

# === เข้าสู่ระบบด้วย Facebook ===
# 1) เข้า developers.facebook.com → My Apps → Create App → เลือกแบบ "Authenticate and
#    request data from users with Facebook Login" (ไม่ต้องเลือก Business ก็ได้)
# 2) เพิ่มผลิตภัณฑ์ "Facebook Login" → Settings → Valid OAuth Redirect URIs ใส่:
#       https://new78.com/api/oauth/facebook/callback
# 3) App settings → Basic → คัดลอก App ID กับ App Secret มาใส่ 2 บรรทัดล่าง
# 4) ตั้ง NEXT_PUBLIC_FACEBOOK_LOGIN=1 เพื่อให้ปุ่ม Facebook บนหน้าเว็บทำงาน
# หมายเหตุ: ตอนแอปยังเป็นโหมด Development จะล็อกอินได้เฉพาะคนที่เป็น
# Admin/Developer/Tester ของแอป — เหมาะกับช่วงทดสอบ พอพร้อมค่อยกด Live
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_LOGIN=
# ไม่ต้องใส่ก็ได้ ค่าเริ่มต้น v23.0 — ใส่เมื่อ Facebook เลิกรองรับเวอร์ชันนั้น
FACEBOOK_API_VERSION=

# === เช็คเอาต์ Phase 1 ===
# เบอร์ PromptPay (0812345678) หรือเลขบัตรประชาชน 13 หลัก — ใช้สร้าง QR
NEXT_PUBLIC_PROMPTPAY_ID=
# Webhook รับออเดอร์จาก Make.com (client POST โดยตรง จึงต้องเป็น NEXT_PUBLIC)
NEXT_PUBLIC_ORDER_WEBHOOK_URL=
