# === เข้าสู่ระบบด้วย LINE ===
# 1) เข้า developers.line.biz → สร้าง Provider → สร้างช่องแบบ "LINE Login"
# 2) แท็บ Basic settings → คัดลอก Channel ID กับ Channel secret มาใส่ 2 บรรทัดล่าง
# 3) แท็บ LINE Login → Callback URL ใส่ให้ตรงกับโดเมนที่ใช้จริง:
#       https://new78.com/api/oauth/line/callback
#    (ย้ายไป gucut.com เมื่อไหร่ ต้องมาเพิ่ม callback ของโดเมนใหม่ด้วย ใส่ได้หลายอันพร้อมกัน)
# 4) ตั้ง NEXT_PUBLIC_LINE_LOGIN=1 เพื่อให้ปุ่ม LINE บนหน้าเว็บทำงาน
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_LOGIN=

# === เข้าสู่ระบบด้วย Facebook ===
# 1) เข้า developers.facebook.com → My Apps → Create App → เลือกแบบ "Authenticate and
#    request data from users with Facebook Login" (ไม่ต้องเลือก Business ก็ได้)
# 2) เพิ่มผลิตภัณฑ์ "Facebook Login" → Settings → Valid OAuth Redirect URIs ใส่:
#       https://new78.com/api/oauth/facebook/callback
# 3) App settings → Basic → คัดลอก App ID กับ App Secret มาใส่ 2 บรรทัดล่าง
# 4) ตั้ง NEXT_PUBLIC_FACEBOOK_LOGIN=1 เพื่อให้ปุ่ม Facebook บนหน้าเว็บทำงาน
# หมายเหตุ: ตอนแอปยังเป็นโหมด Development จะล็อกอินได้เฉพาะคนที่เป็น
# Admin/Developer/Tester ของแอป — เหมาะกับช่วงทดสอบ พอพร้อมค่อยกด Live
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_LOGIN=
# ไม่ต้องใส่ก็ได้ ค่าเริ่มต้น v23.0 — ใส่เมื่อ Facebook เลิกรองรับเวอร์ชันนั้น
FACEBOOK_API_VERSION=

# === เข้าสู่ระบบด้วย Google ===
# 1) เข้า console.cloud.google.com → สร้างโปรเจกต์ (หรือใช้ของเดิม)
# 2) APIs & Services → OAuth consent screen → เลือก External → กรอกชื่อแอป "GUCUT"
#    อีเมลสนับสนุน และโดเมนที่ได้รับอนุญาต new78.com
# 3) APIs & Services → Credentials → Create credentials → OAuth client ID
#    → Application type: Web application
#    → Authorized redirect URIs ใส่:
#         https://new78.com/api/oauth/google/callback
# 4) คัดลอก Client ID กับ Client secret มาใส่ 2 บรรทัดล่าง
# 5) ตั้ง NEXT_PUBLIC_GOOGLE_LOGIN=1 เพื่อให้ปุ่ม Google บนหน้าเว็บทำงาน
# หมายเหตุ: ตอน consent screen ยังเป็น Testing จะล็อกอินได้เฉพาะอีเมลที่ใส่ไว้ใน
# Test users — เหมาะกับช่วงทดสอบ พอพร้อมค่อยกด Publish app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN=

# === เช็คเอาต์ Phase 1 ===
# เบอร์ PromptPay (0812345678) หรือเลขบัตรประชาชน 13 หลัก — ใช้สร้าง QR
NEXT_PUBLIC_PROMPTPAY_ID=
# Webhook รับออเดอร์จาก Make.com (client POST โดยตรง จึงต้องเป็น NEXT_PUBLIC)

# === โค้ดส่วนลดร้านค้า (ไม่ใส่ = ไม่มีโค้ดไหนใช้ได้) ===
# ตรวจโค้ดที่ Netlify Function เท่านั้น (netlify/functions/coupon.mjs)
# ห้ามย้ายไปตรวจในเบราว์เซอร์ ไม่งั้นลูกค้ากด "ดูซอร์ส" ก็เห็นโค้ดทั้งหมด
#
#   type   amount = ลดเป็นบาท · percent = ลดเป็นเปอร์เซ็นต์
#   min    ยอดขั้นต่ำถึงจะใช้ได้        (ไม่ใส่ = ไม่มีขั้นต่ำ)
#   max    เพดานส่วนลด ใช้กับ percent  (ไม่ใส่ = ไม่มีเพดาน)
#   until  วันสุดท้ายที่ใช้ได้ YYYY-MM-DD (ไม่ใส่ = ไม่มีวันหมดอายุ)
#
# ใส่เป็นบรรทัดเดียว เช่น
# COUPON_CODES=[{"code":"GUCUT100","type":"amount","value":100,"min":1000},{"code":"SAVE10","type":"percent","value":10,"min":500,"max":300}]
COUPON_CODES=

# === ส่งต่อออเดอร์ไปที่อื่นอีกทาง (ไม่บังคับ) ===
# ออเดอร์เก็บที่ Netlify + เด้ง Telegram อยู่แล้ว — ใส่ตัวนี้เมื่ออยากส่งเข้า Make.com เพิ่ม
# ยิงจากเซิร์ฟเวอร์ ลูกค้าไม่เห็น URL นี้
ORDER_FORWARD_URL=

# === ชื่อที่ไปโชว์ในหน้า "รายการขาย" ของ ZORT (ไม่บังคับ) ===
# ไม่ใส่ = ใช้ค่าเริ่มต้นในโค้ด (เว็บไซต์ GUCUT / Flash Express / เงินโอน)
# ⚠️ ต้องสะกดตรงกับที่ตั้งไว้ใน ZORT เป๊ะ ๆ ไม่งั้น ZORT ไม่รู้จักแล้วปล่อยคอลัมน์ว่าง
#    ช่องทางการขายสร้างที่ ZORT → ตั้งค่า → ช่องทางการขาย
ZORT_SALES_CHANNEL=
ZORT_SHIPPING_CHANNEL=
ZORT_PAYMENT_METHOD=
