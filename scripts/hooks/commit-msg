#!/bin/bash
# 📌 **แหล่งต้นฉบับของฮุค commit-msg** — ติดตั้งด้วย scripts/install-pre-push.sh
#    🔴 ที่มา 14 ต.ค. 2569: ฮุคนี้เคยอยู่ **แต่ใน .git/hooks/ เท่านั้น** ⇒ ไม่มีสำเนาในรีโป
#       ⇒ ไม่มีใครตรวจว่ามันตรงกับอะไร · หายแล้วสร้างใหม่ไม่ได้ · และมันรันทุก commit
#    🔑 ฝั่งจอเจอรูปเดียวกันคนละแบบ (ของเขามีสำเนาในรีโป แต่ตัวตรวจดูแค่ pre-push
#       ⇒ สำเนาใน .git/ เป็นของเก่า) ⇒ **ตัวตรวจที่ตรวจของชิ้นเดียวในกองที่มีหลายชิ้น
#       รายงานว่ากองนั้นเรียบร้อย** ⇒ ของผมหนักกว่าหนึ่งขั้น: ไม่มีต้นฉบับให้เทียบเลย
# 🔒 จับร่องรอย "ข้อความ commit ถูก shell กิน" — เกิดจริง 18 ก.ย. 2569
#    เขียน `formula_diff` ในเครื่องหมายคำพูดคู่ ⇒ bash รัน backtick เป็นคำสั่ง
#    ⇒ คำนั้นหายจากข้อความ เหลือช่องว่างซ้อน และไม่มีอะไรฟ้อง (commit สำเร็จปกติ)
# 🔑 กฎที่ถูกละเมิดซ้ำต้องกลายเป็นกลไก ไม่ใช่เอกสาร (มีบทเรียนในคลังแล้วยังเหยียบ)
# ตรวจร่องรอย ไม่ใช่ตรวจเจตนา: จุดกลาง/ขีดนำหน้า แล้วตามด้วยช่องว่างซ้อน = มีคำหายไประหว่างนั้น
msg=$(cat "$1")
if grep -nE '(^|[^ ])(·|-|⇒)  +[^ ]' <<<"$msg" | grep -qv '^[0-9]*: *#'; then
  echo "🔴 ข้อความ commit มีช่องว่างซ้อนหลังจุดนำหน้า — น่าจะมีคำหายไปเพราะ shell กิน backtick"
  grep -nE '(·|-|⇒)  +[^ ]' <<<"$msg" | head -5
  echo "   วิธีที่ถูก: เขียนข้อความลงไฟล์แล้ว git commit -F <ไฟล์>  (หรือ heredoc <<'MSG')"
  echo "   ยืนยันว่าตั้งใจเว้นสองช่อง: git commit --no-verify"
  exit 1
fi
